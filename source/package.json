{
  "name": "modu-offline-reader",
  "version": "1.0.0",
  "private": false,
  "description": "A local-first Markdown reader with an offline single-file build.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KennyMcSimpson/modu-reader.git"
  },
  "bugs": {
    "url": "https://github.com/KennyMcSimpson/modu-reader/issues"
  },
  "homepage": "https://github.com/KennyMcSimpson/modu-reader",
  "keywords": ["markdown", "reader", "offline", "local-first", "react", "vite"],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-offline.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "sonner": "2.0.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rehype-katex": "7.0.1",
    "rehype-highlight": "7.0.2",
    "rehype-slug": "6.0.0",
    "mermaid": "11.17.2",
    "dompurify": "3.4.15",
    "katex": "0.16.47"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19"
  },
  "packageManager": "pnpm@11.25.0"
}
