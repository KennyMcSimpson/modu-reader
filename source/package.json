{
  "name": "modu-reader",
  "version": "2.0.0",
  "private": false,
  "description": "A private, offline Markdown reader for Windows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KennyMcSimpson/modu-reader.git"
  },
  "bugs": {
    "url": "https://github.com/KennyMcSimpson/modu-reader/issues"
  },
  "homepage": "https://github.com/KennyMcSimpson/modu-reader",
  "keywords": [
    "markdown",
    "reader",
    "windows",
    "desktop",
    "offline",
    "electron"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/build-desktop.mjs && electron .",
    "build": "node scripts/build-desktop.mjs",
    "build:html": "node scripts/build-offline.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test desktop/tests/*.test.cjs",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "dist:win": "pnpm run build && electron-builder --config electron-builder.yml --win --x64 --publish never"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.15",
    "katex": "0.16.47",
    "lucide-react": "1.31.0",
    "mermaid": "11.17.2",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "packageManager": "pnpm@11.25.0",
  "author": {
    "name": "KennyMcSimpson"
  },
  "main": "desktop/main.cjs"
}
